NODE_ENV=development
PORT=3333
# URL pública do backend (usada pelo Better Auth)
BASE_URL=http://localhost:3333
# Origem do frontend (CORS + origens confiáveis)
FRONTEND_ORIGIN=http://localhost:5173
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=troque-por-um-segredo-com-32-ou-mais-caracteres
# Cadastro público. Mantenha false; crie usuários com `npm run user:create`
ALLOW_SIGNUP=false
# Vazio = PGlite local em ./.data (só dev). Em produção: URL do Neon.
DATABASE_URL=
