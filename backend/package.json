{
  "name": "chimpinho-backend",
  "version": "1.0.0",
  "description": "## Stack (planejada) Node 20+ LTS, Fastify, TypeScript, Zod, Drizzle ORM, PostgreSQL (Neon), Better Auth (confirmar na Fase 0), Cloudflare R2 (anexos, URLs pré-assinadas).",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
